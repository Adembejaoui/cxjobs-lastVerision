generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                     @id @default(uuid())
  name                    String?
  email                   String                     @unique
  emailVerified           DateTime?
  passwordHash            String?
  image                   String?
  role                    UserRole                   @default(CANDIDATE)
  isOnboarded             Boolean                    @default(false)
  isActive                Boolean                    @default(true)
  /// Incremented to revoke every existing session (password reset, suspension, identity change).
  sessionVersion          Int                        @default(0)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  deletedAt               DateTime?
  accounts                Account[]
  candidate               Candidate?
  companies               companies?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sessions                Session[]
  notifications           Notification[]
  applicationStatusEvents ApplicationStatusHistory[]

  @@index([email])
  @@index([role])
  @@index([role, isActive])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique(map: "pr_password_reset_token")
  expires   DateTime
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires])
  @@index([userId])
  @@index([email])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique(map: "pr_email_verification_token")
  expires   DateTime
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires])
  @@index([userId])
  @@index([email])
  @@map("email_verification_tokens")
}

model Candidate {
  id                String           @id @default(uuid())
  userId            String           @unique
  firstName         String?
  lastName          String?
  phone             String?
  location          String?
  headline          String?
  summary           String?
  avatarUrl         String?
  resumeUrl         String?
  cvParsed          Boolean          @default(false)
  linkedinUrl       String?
  preferredJobTypes String[]         @default([])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  shiftType         ShiftType[]      @default([])
  targetJobRole     JobRoleTarget?   @default(GENERAL)
  workMode          WorkMode?
  dateOfBirth       DateTime?
  gender            String?
  lastCvExportAt    DateTime?
  cvExportCount     Int              @default(0)
  applications      Application[]
  skills            CandidateSkill[]
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  education         Education[]
  experiences       Experience[]
  languages         Language[]

  @@index([userId])
  @@index([dateOfBirth])
  @@index([gender])
  @@index([lastCvExportAt])
  @@map("candidates")
}

model CandidateSkill {
  id                String    @id @default(uuid())
  candidateId       String
  name              String
  level             String?
  yearsOfExperience Int?
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_skills")
}

model Experience {
  id          String    @id @default(uuid())
  candidateId String
  company     String
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("experiences")
}

model Education {
  id           String    @id @default(uuid())
  candidateId  String
  school       String
  degree       String
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  description  String?
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("education")
}

model Language {
  id          String    @id @default(uuid())
  candidateId String
  name        String
  proficiency String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("languages")
}

model CompanyCount {
  id        String    @id @default(uuid())
  companyId String    @unique
  jobs      Int       @default(0)
  employees Int       @default(0)
  followers Int       @default(0)
  company   companies @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_counts")
}

model CompanyBenefit {
  id          String            @id @default(uuid())
  companyId   String
  name        String
  description String?
  icon        String?
  category    BenefitCategory   @default(OTHER)
  scope       BenefitScope      @default(ADDITIONAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  company     companies         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobOffers   JobOfferBenefit[]

  @@index([companyId])
  @@index([scope])
  @@map("company_benefits")
}

model JobOffer {
  id               String            @id @default(uuid())
  companyId        String
  title            String
  slug             String            @unique
  description      String?
  requirements     String[]          @default([])
  customLocation   String?
  contractType     ContractType      @default(CDI)
  isRemote         Boolean           @default(false)
  isHybrid         Boolean           @default(false)
  employmentType   EmploymentType    @default(FULL_TIME)
  salary           String?
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String?           @default("USD")
  status           JobOfferStatus    @default(DRAFT)
  publishedAt      DateTime?
  closedAt         DateTime?
  expiresAt        DateTime?
  featured         Boolean           @default(false)
  highlight        Boolean           @default(false)
  metaTitle        String?
  metaDescription  String?
  aiGenerated      Boolean           @default(false)
  aiModel          String?
  views            Int               @default(0)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  softSkills       String[]          @default([])
  technicalTools   String[]          @default([])
  activityType     ActivityType      @default(CUSTOMER_SERVICE)
  activityCustom   String?
  applicationType  ApplicationMethod @default(INTERNAL)
  externalApplyUrl String?
  applications     Application[]
  languages        JobLanguage[]
  benefits         JobOfferBenefit[]
  company          companies         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([slug])
  @@index([contractType])
  @@index([employmentType])
  @@index([activityType])
  @@index([companyId, status, deletedAt])
  @@index([companyId, status, createdAt])
  @@index([status, createdAt])
  @@index([deletedAt, status, createdAt])
  @@index([companyId, deletedAt, status, createdAt])
  // Trigram GIN indexes serving case-insensitive substring search
  // (`contains` + `mode: "insensitive"` → ILIKE '%…%') in lib/job-offers-utils.ts
  // and the candidate dashboard. They MUST be declared here: indexes missing
  // from the schema are treated as drift and dropped by `prisma migrate dev`,
  // which is exactly how earlier migrations lost them. Requires pg_trgm
  // (created in migration 20261109130000_restore_trigram_search_indexes).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_job_offers_title_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_job_offers_description_trgm")
  @@index([customLocation(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_job_offers_custom_location_trgm")
  @@map("job_offers")
}

model JobOfferBenefit {
  id                String         @id @default(uuid())
  jobOfferId        String
  benefitId         String
  customDescription String?
  benefit           CompanyBenefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  jobOffer          JobOffer       @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  @@unique([jobOfferId, benefitId])
  @@index([jobOfferId])
  @@index([benefitId])
  @@map("job_offer_benefits")
}

model JobLanguage {
  id         String        @id @default(uuid())
  jobOfferId String
  language   String
  level      LanguageLevel @default(REQUIRED)
  jobOffer   JobOffer      @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  @@unique([jobOfferId, language])
  @@index([jobOfferId])
  @@index([language, level, jobOfferId])
  @@map("job_languages")
}

model Application {
  id            String                     @id @default(uuid())
  candidateId   String
  jobOfferId    String
  coverLetter   String?
  cvUrl         String?
  status        ApplicationStatus          @default(NOUVEAU)
  notes         String?
  isSaved       Boolean                    @default(false)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  candidate     Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOffer      JobOffer                   @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  statusHistory ApplicationStatusHistory[]

  @@unique([candidateId, jobOfferId])
  @@index([candidateId, createdAt])
  @@index([candidateId, status])
  @@index([candidateId, status, isSaved])
  @@index([jobOfferId, status])
  @@index([jobOfferId, createdAt])
  @@index([createdAt])
  @@index([status])
  @@map("applications")
}

model companies {
  id               String                @id @default(uuid())
  userId           String                @unique
  name             String
  slug             String                @unique
  logoUrl          String?
  coverImageUrl    String?
  companySize      String?
  location         String?
  website          String?
  foundedYear      Int?
  description      String?
  culture          String?
  isRemoteFriendly Boolean               @default(false)
  isHybridFriendly Boolean               @default(false)
  linkedinUrl      String?
  twitterUrl       String?
  facebookUrl      String?
  emailCompany     String?
  isVerified       Boolean               @default(false)
  verifiedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  users            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  benefits         CompanyBenefit[]
  count            CompanyCount?
  jobs             JobOffer[]
  slugRedirects    CompanySlugRedirect[]

  @@index([slug])
  @@index([userId])
  @@index([name])
  // Trigram GIN indexes for job search by company name / location (see the
  // note on job_offers). Declared so `prisma migrate dev` never drops them.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_companies_name_trgm")
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_companies_location_trgm")
  @@map("companies")
}

/// A company's previous public slugs (launch plan A6). Old /companies/<slug>
/// links keep working by redirecting to the company's current slug. A slug
/// listed here cannot be claimed by another company.
model CompanySlugRedirect {
  slug      String    @id
  companyId String
  createdAt DateTime  @default(now())
  company   companies @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_slug_redirects")
}

/// Append-only record of every application status change (launch plan A7).
model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  createdAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User?              @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

/// In-app notifications (launch plan A7).
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model CompanyInvitation {
  id             String                  @id @default(uuid())
  tokenHash      String                  @unique
  tokenEncrypted String?
  companyName    String
  companyEmail   String
  managerName    String?
  managerEmail   String?
  createdAt      DateTime                @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  status         CompanyInvitationStatus @default(PENDING)

  @@index([companyEmail])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([status])
  @@map("company_invitations")
}

model LandingPageVisitor {
  id          String   @id @default(uuid())
  visitorHash String   @unique
  firstSeenAt DateTime @default(now())

  @@index([firstSeenAt])
  @@map("landing_page_visitors")
}

enum UserRole {
  CANDIDATE
  COMPANY
  ADMIN
}

enum CompanyInvitationStatus {
  PENDING
  IN_PROGRESS
  CREATED
  CLOSED
}

enum JobRoleTarget {
  CALL_CENTER
  SALES
  TECH_SUPPORT
  CUSTOMER_SERVICE
  ADMIN
  GENERAL
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum ShiftType {
  DAY
  NIGHT
  FLEXIBLE
  ROTATION
}

enum BenefitScope {
  CORE
  ADDITIONAL
}

enum BenefitCategory {
  HEALTH
  FINANCIAL
  WORK_ENVIRONMENT
  CAREER_GROWTH
  WORK_LIFE_BALANCE
  OTHER
}

enum JobOfferStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CLOSED
  EXPIRED
}

enum ContractType {
  CDI
  CIVP
  KARAMA
  FREELANCE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

enum LanguageLevel {
  REQUIRED
  PREFERRED
  NICE_TO_HAVE
}

enum ApplicationMethod {
  INTERNAL
  EXTERNAL
}

enum ApplicationStatus {
  NOUVEAU
  EN_COURS_EXAMEN
  ENTRETIEN
  EMBAUCHES
  REFUSE
}

enum NotificationType {
  NEW_APPLICATION
  APPLICATION_STATUS_CHANGED
}

enum ActivityType {
  CUSTOMER_SERVICE
  SALES_LEAD_GENERATION
  TECHNICAL_IT_SUPPORT
  DEBT_COLLECTION_LITIGATION
  BACK_OFFICE_DIGITAL_SERVICES
  SURVEYS_MARKET_RESEARCH
  OTHER
}
