# Copy to `.env` (or `.env.local`) and fill in values for YOUR environment.
# Never put production credentials in a development checkout: Next.js loads
# `.env` automatically for `next dev` AND `next build`.
#
# prisma.config.ts loads this file via dotenv for the Prisma CLI.

# ==================== Database ====================
# DATABASE_URL: pooled connection used by the app at runtime.
# DIRECT_DATABASE_URL: direct connection used only by Prisma migrate/introspect
# (DIRECT_URL is accepted as a legacy alias). `prisma generate` needs neither.
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/cxjobs?schema=public"
DATABASE_URL="postgresql://user:password@localhost:6543/cxjobs?pgbouncer=true"

# Authentication secrets (generate with: openssl rand -base64 32)
# NextAuth v5 uses AUTH_SECRET (NEXTAUTH_SECRET also supported as fallback)
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Application URL (update for production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==================== Google OAuth ====================
# Get these from: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OpenAI API key for AI features (job description generation, CV parsing)
OPENAI_API_KEY="your-openai-api-key"

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Redis configuration (for rate limiting and caching in production)
# Get these from https://upstash.com
# For local development, Redis is optional - the app falls back to in-memory cache
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Invitation token encryption: base64 of exactly 32 bytes, REQUIRED (checked at
# module load, so `next build` fails without a valid value).
# Generate with: openssl rand -base64 32
# The all-zero value below is a format-valid placeholder for local use ONLY.
INVITATION_TOKEN_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# Rate limiting: REQUIRED in production. Without Upstash Redis, sensitive
# endpoints (login, password reset, AI, scraping, CV parsing) fail CLOSED.
# Outside production an in-process limiter is used instead.
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN above)

# Email verification enforcement (credentials login + session refresh).
# Leave "false" until verification emails are actually delivered; enabling it
# earlier locks out every unverified credentials account. Google sign-ins are
# trusted only when Google reports email_verified=true.
REQUIRE_EMAIL_VERIFICATION=false

# Transactional email (password reset, email verification).
# "disabled" (default) sends nothing. "resend" uses the Resend HTTPS API.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend, e.g. "CXJobs <no-reply@cxjobs.app>"
EMAIL_FROM=
# Base URL used in emailed links. Only configuration is trusted (never the
# request Host header). Must be https in production. Falls back to
# NEXT_PUBLIC_APP_URL.
APP_URL=

# ==================== Scheduled tasks (launch plan A2) ====================
# Vercel Cron calls GET /api/job-offers/expire nightly (vercel.json) with
# "Authorization: Bearer $CRON_SECRET". Without it (or under 16 characters)
# the scheduled run is refused. Generate with: openssl rand -base64 32
CRON_SECRET=

# ==================== AI usage (launch plan S7) ====================
# Paid AI calls (job generation, job import from URL, CV parsing) allowed per
# user per UTC day, shared across all AI features. Default 30.
AI_DAILY_QUOTA=30

# ==================== Test data (never production) ====================
# prisma/seed.ts and prisma/seed-k6.ts refuse to run without a password here
# (min. 12 characters), always refuse the production database, and require
# SEED_ALLOW_DATABASE_HOST=<exact host> for any non-local database.
SEED_TEST_PASSWORD=
SEED_ALLOW_DATABASE_HOST=
# k6 session generators log in with the password the staging seed used.
K6_TEST_PASSWORD=
K6_COMPANY_PASSWORD=

# ==================== Monitoring (launch plan A9) ====================
# Optional https webhook (Slack/Discord/incident tool) that receives one
# minimal JSON message per unhandled server error (no personal data).
ERROR_ALERT_WEBHOOK_URL=
